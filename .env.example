# Job Search Agent Environment Variables

# JSearch API Key (required)
# Get your API key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_api_key_here

# LLM Provider Keys (optional - for future use)
# Uncomment and configure when switching from local Ollama to cloud providers

# Anthropic API Key
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# LiteLLM Configuration (optional)
# LITELLM_MASTER_KEY=your_litellm_key_if_using_proxy